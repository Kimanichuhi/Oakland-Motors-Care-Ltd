# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings > API). Never commit the real .env file.

# Public — safe to expose to the browser. Access is enforced entirely by
# Row Level Security policies in the database, not by keeping this secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret — server-side only, bypasses Row Level Security. Never expose this
# to the browser or commit it. Used by scripts/tooling that need admin
# access; the app's Edge Functions (supabase/functions/*) read their own
# copy from Supabase's function secrets, not from this file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
